# ── 앱 기본 ──
DEBUG=false
LOG_LEVEL=INFO
BASE_DOMAIN=fabbit.io
BASE_API_URL=https://api.fabbit.io

# ── PostgreSQL + Apache AGE ──
POSTGRES_USER=fabbit
POSTGRES_PASSWORD=
POSTGRES_DB=fabbit
DATABASE_HOST=fabbit-db
DATABASE_PORT=5432
DATABASE_NAME=fabbit
DATABASE_USER=fabbit
DATABASE_PASSWORD=

# ── JWT 인증 ──
# openssl rand -base64 32
JWT_SECRET_KEY=

# ── S3 호환 스토리지 (Cloudflare R2) ──
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=fabbit
STORAGE_PUBLIC_URL=

# ── LLM (OpenRouter) ──
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1

# ── Drawing Converter ──
DRAWING_CONVERTER_URL=http://fabbit-drawing-converter:8100
# openssl rand -base64 32 (server와 converter에 동일 값)
DRAWING_CONVERTER_SECRET=
CONVERTER_SECRET=
CONVERTER_S3_ENDPOINT=
CONVERTER_S3_ACCESS_KEY=
CONVERTER_S3_SECRET_KEY=
CONVERTER_S3_BUCKET=fabbit
CONVERTER_S3_REGION=auto
CONVERTER_MAX_CONCURRENT=2
CONVERTER_CLEANUP_AFTER_HOURS=24
CONVERTER_LOG_RETENTION_DAYS=30

# ── Cloudflare Turnstile ──
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=

# ── OpenTelemetry (선택) ──
OTEL_ENABLED=false
# OTEL_EXPORTER_ENDPOINT=
# OTEL_EXPORTER_HEADERS=
