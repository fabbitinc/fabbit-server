# ── 앱 기본 ──
APP_NAME=Fabbit Ontology Engine
DEBUG=false
LOG_LEVEL=INFO
BASE_DOMAIN=lvh.me  # lvh.me (local) / fabbit.io (prod)
BASE_API_URL=http://localhost:8000  # webhook callback URL 구성용

# ── Background Worker ──
BACKGROUND_MAX_WORKERS=3

# ── PostgreSQL (Apache AGE) ──
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fabbit
DATABASE_USER=fabbit
DATABASE_PASSWORD=fabbit
GRAPH_NAME=fabbit_graph

# ── JWT 인증 ──
# 시크릿 생성: openssl rand -base64 32
JWT_SECRET_KEY=super-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=fabbit
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── S3 호환 스토리지 (Cloudflare R2 / MinIO) ──
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=fabbit
STORAGE_PUBLIC_URL=  # CDN URL (없으면 endpoint 사용)

# ── Drawing Converter MSA ──
DRAWING_CONVERTER_URL=  # 빈 문자열이면 비활성화 (예: http://localhost:8001)
DRAWING_CONVERTER_SECRET=  # openssl rand -base64 32 — Converter MSA와 동일한 값 설정

# ── OpenAI ──
OPENAI_API_KEY=sk-...

# ── Cloudflare Turnstile (봇 방지) ──
TURNSTILE_SECRET_KEY=  # Cloudflare 대시보드에서 발급
TURNSTILE_ENABLED=false  # true로 설정 시 회원가입에 Turnstile 검증 필수

# ── OpenTelemetry ──
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fabbit-core
OTEL_EXPORTER_ENDPOINT=  # 비어있으면 콘솔 출력, 값 있으면 OTLP (예: http://localhost:4317)
OTEL_EXPORTER_HEADERS=   # "key1=value1,key2=value2" 형식 (인증 헤더 등)
