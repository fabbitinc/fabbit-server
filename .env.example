# ── 앱 기본 ──
PORT=10010
APP_NAME='Fabbit Server'
DEBUG=false
LOG_LEVEL=INFO
BASE_DOMAIN=lvh.me  # lvh.me (local) / fabbit.io (prod)
BASE_API_URL=http://localhost:8000  # webhook callback URL 구성용

# ── Background Worker ──
BACKGROUND_MAX_WORKERS=3

# ── PostgreSQL (Apache AGE) ──
DATABASE_URL=jdbc:postgresql://loaclhost:5432/fabbit
DATABASE_USER=fabbit
DATABASE_PASSWORD=fabbit
GRAPH_NAME=fabbit_graph

# ── JWT 인증 ──
# 시크릿 생성: openssl rand -base64 32
JWT_SECRET_KEY=super-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=fabbit
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── S3 호환 스토리지 (Cloudflare R2 / MinIO) ──
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=fabbit
STORAGE_PUBLIC_URL=  # CDN URL (없으면 endpoint 사용)

# ── Drawing Converter (로컬) ──
QCAD_PATH=/opt/qcad  # Mac: /Applications/QCAD-Pro.app/Contents/Resources
EZDXF_BIN_PATH=/Users/seongha.moon/.local/bin/ezdxf
THREE_D_CONVERTER_BIN_PATH=/opt/mayo-conv  # 비워두면 fabbit-3dconverter Docker fallback 사용
CONVERTER_MAX_CONCURRENT=2
CONVERTER_TEMP_DIR=/tmp/drawing-converter
CONVERTER_COMMAND_TIMEOUT_SECONDS=300
CONVERTER_PIPELINE_TIMEOUT_SECONDS=420
CONVERTER_TEMP_DIR_CLEANUP_MAX_AGE_HOURS=24

# ── LLM (OpenRouter) ──
LLM_API_KEY=sk-or-변경필요
LLM_BASE_URL=https://openrouter.ai/api/v1

# ── SMTP (이메일) ──
SMTP_HOST=localhost
SMTP_PORT=1025          # Mailpit SMTP
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@fabbit.io
SMTP_FROM_NAME=Fabbit

# ── 초대 ──
INVITATION_EXPIRE_DAYS=7
INVITATION_BASE_URL=http://localhost:5173  # 프론트엔드 초대 수락 페이지 base URL

# ── Cloudflare Turnstile (봇 방지) ──
TURNSTILE_SECRET_KEY=  # Cloudflare 대시보드에서 발급
TURNSTILE_ENABLED=false  # true로 설정 시 회원가입에 Turnstile 검증 필수

# ── OpenTelemetry ──
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fabbit-core
OTEL_EXPORTER_ENDPOINT=  # 비어있으면 콘솔 출력, 값 있으면 OTLP (예: http://localhost:4317)
OTEL_EXPORTER_HEADERS=   # "key1=value1,key2=value2" 형식 (인증 헤더 등)
